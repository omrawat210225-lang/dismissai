{
  "version": 2,
  "outputDirectory": "public",
  "builds": [
    { "src": "public/**", "use": "@vercel/static" },
    { "src": "api/*.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/settle", "dest": "/api/settle.js" },
    { "src": "/api/redflag", "dest": "/api/redflag.js" },
    { "src": "/api/rant", "dest": "/api/rant.js" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
